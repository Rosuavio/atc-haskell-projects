cabal-version:       3.14
name:                todo-manager
version:             0.1.0.0
description:         A simple todo manager
category:            CLI
build-type:          Simple

executable todo-manager
  main-is:             Main.hs
  hs-source-dirs:      src
  default-language:    GHC2024
  ghc-options:         -Wall
  build-depends:       base >=4.7 && <5, transformers
